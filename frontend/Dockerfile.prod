# MUST use repository root as build context (not ./frontend), so COPY frontend/ works.
#
#   docker buildx build --platform linux/amd64,linux/arm64 -f frontend/Dockerfile.prod -t jonymaster/catalogit-ui:1.0.0 --push .
#
# Using `--push ./frontend` will fail: context has no `frontend/` subpath.
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# Logos and favicon live in frontend/src/assets/branding (bundled under /assets/ in production).

# Optional: set when API is on another hostname (e.g. https://api-catalogit.example.org).
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY frontend/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
