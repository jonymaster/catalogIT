# PostgreSQL
POSTGRES_USER=catalogit
POSTGRES_PASSWORD=catalogit_local
POSTGRES_DB=catalogit
DATABASE_URL=postgresql+asyncpg://catalogit:catalogit_local@db:5432/catalogit

# JWT
JWT_SECRET=change-me-to-a-random-secret

# Frontend origin (used for CORS and auth callback redirect)
FRONTEND_URL=http://localhost:5173

# SCIM provisioning token
SCIM_TOKEN=change-me-to-a-random-scim-token

# First-run admin seed (only used when no admin exists yet)
ADMIN_DEFAULT_PASSWORD=changeme
ADMIN_EMAIL=admin@catalogit.local
ADMIN_EXTERNAL_ID=local:admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Public URL of the API (OAuth redirect URIs for outbound integrations). Local dev: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# Fernet key for encrypting integration tokens at rest: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=

# Load bundled sample/reference data on local startup
SEED_SAMPLE_DATA=true

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=catalogit
MINIO_ROOT_PASSWORD=catalogit_local
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=catalogit
MINIO_SECRET_KEY=catalogit_local
MINIO_BUCKET_NAME=catalogit-attachments

# Shared secret for scheduled renewal reminder job: POST /api/internal/notifications/renewal-dispatch with header X-Cron-Secret
CRON_SECRET=

# Alternative: run reminders without HTTP (same DB as DATABASE_URL):
# docker compose exec api python -m app.jobs.run_renewal_reminders
