# =============================================================================
# CatalogIT — environment template
# =============================================================================
# Copy to `.env` and edit. Never commit `.env`.
#
# Used by:
#   - Backend (Pydantic Settings): all variables in "Application" except where
#     noted as Compose-only.
#   - `docker compose` / `docker compose -f docker-compose.server.yml` for
#     substitution and for services that read POSTGRES_* / MINIO_ROOT_*.
#
# Local dev: `docker compose up` (see README).
# Server: `docker compose -f docker-compose.server.yml up -d` — set strong
# secrets, HTTPS URLs, and SEED_SAMPLE_DATA=false unless you want demo data.
# =============================================================================

# --- Application (backend; env_file on the `api` container) ---------------

# PostgreSQL (async). User/password/db must match POSTGRES_* below.
# Host `db` only resolves inside Compose; on the host use localhost and the
# published db port if you run tools outside Docker.
DATABASE_URL=postgresql+asyncpg://catalogit:catalogit_local@db:5432/catalogit

# JWT signing — use a long random string in production.
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# Public browser origin (scheme + host + port). CORS and auth redirects.
# Local Vite: http://localhost:5173
# Production (same hostname as users type in the browser):
# FRONTEND_URL=https://catalogit.example.com
FRONTEND_URL=http://localhost:5173

# Public base URL of this API (OAuth callbacks, integration metadata, links).
# Local API: http://localhost:8000
# Production (often same host as FRONTEND_URL if NPM routes /api to the API):
# PUBLIC_BASE_URL=https://catalogit.example.com
PUBLIC_BASE_URL=http://localhost:8000

# Fernet key (url-safe base64, 32 bytes) for encrypting integration tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=

# Bearer token for SCIM 2.0 provisioning endpoints — set a long random value in production.
SCIM_TOKEN=change-me-to-a-random-scim-token

# First-run bootstrap admin (only when no admin user exists yet).
ADMIN_DEFAULT_PASSWORD=changeme
ADMIN_EMAIL=admin@catalogit.local
ADMIN_EXTERNAL_ID=local:admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Load reference/sample data on startup. Use false in production.
# Dev compose defaults the API service to true if unset; prefer setting explicitly.
SEED_SAMPLE_DATA=true

# S3-compatible storage (Compose service `minio`). MINIO_ACCESS_KEY / MINIO_SECRET_KEY
# must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=catalogit
MINIO_SECRET_KEY=catalogit_local
MINIO_BUCKET_NAME=catalogit-attachments
MINIO_USE_SSL=false

# Shared secret for internal cron/HTTP: POST /api/internal/notifications/renewal-dispatch
# (header X-Cron-Secret) and related internal routes. Set in production.
CRON_SECRET=

# Logging: "text" or "json" (structured stdout; useful behind log aggregation).
LOG_FORMAT=text

# Audit rows older than this many days can be purged via POST /api/internal/audit-retention.
AUDIT_RETENTION_DAYS=90

# --- Docker Compose: PostgreSQL (service `db`) ----------------------------

POSTGRES_USER=catalogit
POSTGRES_PASSWORD=catalogit_local
POSTGRES_DB=catalogit

# --- Docker Compose: MinIO (service `minio`) --------------------------------

MINIO_ROOT_USER=catalogit
MINIO_ROOT_PASSWORD=catalogit_local

# --- Docker Compose: server file only (docker-compose.server.yml) ---------
# Not read by the backend. Adjust if host ports conflict (e.g. 8000 in use).
#
# API_PUBLISH=18000
# UI_PUBLISH=8080
# CATALOGIT_TAG=1.0.0

# --- Optional ---------------------------------------------------------------
# Renewals without HTTP cron (same DATABASE_URL as the API), from the repo:
#   docker compose exec api python -m app.jobs.run_renewal_reminders
