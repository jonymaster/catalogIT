# --- Backend (app.config.Settings; loaded via env_file on the API container) ---

# Host "db" works inside Docker Compose only. For alembic/scripts on your machine, use localhost:5432.
DATABASE_URL=postgresql+asyncpg://catalogit:catalogit_local@db:5432/catalogit

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# Browser origin for CORS and auth redirects (local Vite default)
FRONTEND_URL=http://localhost:5173

# Where this API is reachable (OAuth callbacks, integration metadata). Local: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# Fernet key (urlsafe base64 32 bytes) for encrypting integration tokens at rest:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=

# SCIM provisioning token
SCIM_TOKEN=change-me-to-a-random-scim-token

# Bootstrap admin (only when no admin user exists yet; see main._seed_admin)
ADMIN_DEFAULT_PASSWORD=changeme
ADMIN_EMAIL=admin@catalogit.local
ADMIN_EXTERNAL_ID=local:admin
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Load bundled sample/reference data on startup (bare-run default in Settings is false; Docker Compose defaults API to true if unset)
SEED_SAMPLE_DATA=true

# MinIO client (S3-compatible; API uses these; match MINIO_ROOT_* below for local compose)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=catalogit
MINIO_SECRET_KEY=catalogit_local
MINIO_BUCKET_NAME=catalogit-attachments
MINIO_USE_SSL=false

# POST /api/internal/notifications/renewal-dispatch — header X-Cron-Secret
CRON_SECRET=

# Logging: "text" (default) or "json" for structured stdout (CloudWatch / log aggregation)
LOG_FORMAT=text

# Global audit: POST /api/internal/audit-retention deletes rows older than this many days (default 90)
AUDIT_RETENTION_DAYS=90

# --- Docker Compose only (not read by backend Settings; extra keys are ignored by Pydantic) ---

POSTGRES_USER=catalogit
POSTGRES_PASSWORD=catalogit_local
POSTGRES_DB=catalogit

MINIO_ROOT_USER=catalogit
MINIO_ROOT_PASSWORD=catalogit_local

# Alternative: run reminders without HTTP (same DB as DATABASE_URL):
# docker compose exec api python -m app.jobs.run_renewal_reminders
